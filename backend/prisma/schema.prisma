// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// Estados

enum EstadoProducto {
  DISPONIBLE
  ACTIVO
  INACTIVO
}



model Provincia {
  id                 Int         @id @default(autoincrement())
  nombre             String      @unique
  codigoIndec        String      @unique
  archivado          Boolean     @default(false)
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt

  localidades        Localidad[]
  depositos          Deposito[]
  sucursales         Sucursal[] 
  clientes           Cliente[]

  @@map("provincias")
}

model Localidad {
  id                 Int       @id @default(autoincrement())
  nombre             String
  codigoIndec        String    @unique
  archivado          Boolean   @default(false)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  provinciaId        Int
  provincia          Provincia @relation(fields: [provinciaId], references: [id])

  depositos          Deposito[]
  sucursales         Sucursal[]
  clientes           Cliente[]

  @@unique([nombre, provinciaId])
  @@map("localidades")
}


// Marca

model Marca {
  id                 Int        @id @default(autoincrement())
  nombre             String     @unique
  archivado          Boolean    @default(false)
  fechaCreacion      DateTime   @default(now())
  fechaActualizacion DateTime   @updatedAt

  productos          Producto[]

  @@map("marcas")
}


// Categorias (Nivel1 - Nivel2)

model CategoriaNivel1 {
  id                 Int               @id @default(autoincrement())
  nombre             String            @unique
  archivado          Boolean           @default(false)
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt

  categoriasNivel2   CategoriaNivel2[]

  @@map("categorias_nivel1")
}

model CategoriaNivel2 {
  id                 Int             @id @default(autoincrement())
  nombre             String          
  archivado          Boolean         @default(false)
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt

  categoriaNivel1Id  Int
  categoriaNivel1    CategoriaNivel1 @relation(fields: [categoriaNivel1Id], references: [id])

  productos          Producto[]

  @@unique([nombre, categoriaNivel1Id])
  @@map("categorias_nivel2")
}


// Depositos

model Deposito {
  id                 Int                     @id @default(autoincrement())
  codigo             String                  @unique // (deposito 1 - deposito 2)
  nombre             String
  archivado          Boolean                 @default(false)
  fechaCreacion      DateTime                @default(now())
  fechaActualizacion DateTime                @updatedAt

  provinciaId        Int
  provincia          Provincia               @relation(fields: [provinciaId], references: [id])

  localidadId        Int
  localidad          Localidad               @relation(fields: [localidadId], references: [id])

  stocks             StockProductoDeposito[]

  @@map("depositos")
}


// Producto

model Producto {
  id                                   Int             @id @default(autoincrement())
  nombre                               String

  // Calculado: suma del stock de todos los depositos

  stockTotal                           Int             @default(0)

  costoNeto                            Decimal         @db.Decimal(12, 2)
  utilidadPorcentaje                   Decimal         @db.Decimal(5, 2)

  // Calculado: costoNeto + utilidadPorcentaje 

  precioLista                          Decimal         @db.Decimal(12, 2)

  descuentoContadoPorcentaje           Decimal         @db.Decimal(5, 2)

  // Calculado: precioLista - % descuentoContadoPorcentaje 

  precioContado                        Decimal         @db.Decimal(12, 2)

  estado                               EstadoProducto  @default(DISPONIBLE)

  fechaHoraUltimoMovimientoStock       DateTime?
  fechaHoraUltimaSincronizacionStock   DateTime?

  rutaImagenStorage                    String?

  marcaId                              Int
  marca                                Marca           @relation(fields: [marcaId], references: [id])

  categoriaNivel2Id                    Int
  categoriaNivel2                      CategoriaNivel2 @relation(fields: [categoriaNivel2Id], references: [id])

  archivado                            Boolean         @default(false)
  fechaCreacion                        DateTime        @default(now())
  fechaActualizacion                   DateTime        @updatedAt

  stocks                               StockProductoDeposito[]
  presupuestoItems                     PresupuestoItem[]

  @@map("productos")
}


// Stock del Producto x Deposito (tabla intermedia)

model StockProductoDeposito {
  id                 Int      @id @default(autoincrement())

  productoId         Int
  producto           Producto @relation(fields: [productoId], references: [id])

  depositoId         Int
  deposito           Deposito @relation(fields: [depositoId], references: [id])

  stock              Int      @default(0)
  ultimoMovimiento   String?  // "INGRESO" | "EGRESO" | "TRANSFERENCIA_ORIGEN" | "TRANSFERENCIA_DESTINO"


  archivado          Boolean  @default(false)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@unique([productoId, depositoId]) // un producto no puede tener 2 filas para el mismo deposito
  @@map("stock_producto_deposito")
}

// Proovedor (sin relaciones por ahora, se conecta con Producto en la Guía 2)
model Proveedor {
  id                 Int      @id @default(autoincrement())
  razonSocial        String
  cuit               String   @unique
  archivado          Boolean  @default(false)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("proveedores")
}

// Sucursal

enum RolUsuario {
  ADMINISTRACION
  VENDEDOR
}

model Sucursal {
  id                 Int      @id @default(autoincrement())
  nombre             String
  archivado          Boolean  @default(false)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  provinciaId        Int
  provincia          Provincia @relation(fields: [provinciaId], references: [id])

  localidadId        Int
  localidad          Localidad @relation(fields: [localidadId], references: [id])

  usuarios           Usuario[]

  @@unique([nombre, provinciaId, localidadId])
  @@map("sucursales")
}

// Usuario

model Usuario {
  id                 Int        @id @default(autoincrement())
  nombre             String
  apellido           String
  dni                String     @unique
  nombreUsuario      String     @unique
  rol                RolUsuario
  archivado          Boolean    @default(false)
  fechaCreacion      DateTime   @default(now())
  fechaActualizacion DateTime   @updatedAt

  sucursalId         Int
  sucursal           Sucursal   @relation(fields: [sucursalId], references: [id])

  @@map("usuarios")
}

// Cliente

model Cliente {
  id                 Int      @id @default(autoincrement())
  nombre             String
  apellido           String
  dni                String   @unique
  email              String   @unique
  archivado          Boolean  @default(false)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  provinciaId        Int
  provincia          Provincia @relation(fields: [provinciaId], references: [id])

  localidadId        Int
  localidad          Localidad @relation(fields: [localidadId], references: [id])
  presupuestos       Presupuesto[]

  @@map("clientes")
}

// Presupuesto 


model Presupuesto {
  id                 Int               @id @default(autoincrement())
  fechaEmision       DateTime          @default(now())
  total              Decimal           @db.Decimal(12, 2)
  archivado          Boolean           @default(false)
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt

  clienteId          Int
  cliente            Cliente           @relation(fields: [clienteId], references: [id])

  items              PresupuestoItem[]

  @@map("presupuestos")
}

model PresupuestoItem {
  id                 Int         @id @default(autoincrement())

  presupuestoId      Int
  presupuesto        Presupuesto @relation(fields: [presupuestoId], references: [id])

  productoId         Int
  producto           Producto    @relation(fields: [productoId], references: [id])

  cantidad           Int
  precioUnitario     Decimal     @db.Decimal(12, 2) // precio de lista al momento de emitir
  subtotal           Decimal     @db.Decimal(12, 2) // cantidad * precioUnitario

  @@map("presupuesto_items")
}

